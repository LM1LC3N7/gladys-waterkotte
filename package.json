{
  "name": "gladys-waterkotte",
  "version": "0.1.2",
  "private": true,
  "description": "Gladys Assistant external integration for Waterkotte heat pumps (EcoTouch, EasyCon) through their local web interface: temperatures, state, compressor, hot water, optional commands with a capped hot water setpoint and an always-allowed Off. Unofficial, not affiliated with Waterkotte.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
